serverAddr = "{{ getenv "FRPC_SERVER_ADDR" }}"
serverPort = {{ getenv "FRPC_SERVER_PORT" "8080" }}
{{- if getenv "FRPC_TRANSPORT_PROXY_URL" }}
transport.proxyURL = "{{ getenv "FRPC_TRANSPORT_PROXY_URL" }}"
{{- end }}

auth.method = "{{ getenv "FRPC_AUTH_METHOD" "token" }}"
{{- if getenv "FRPC_AUTH_ADDITIONAL_SCOPES" }}
auth.additionalScopes = {{ getenv "FRPC_AUTH_ADDITIONAL_SCOPES" }}
{{- end }}
{{- if eq (getenv "FRPC_AUTH_METHOD") "token" }}
auth.token = "{{ getenv "FRPC_AUTH_TOKEN" }}"    
{{- end }}
{{- if eq (getenv "FRPC_AUTH_METHOD") "oidc" }}
auth.oidc.clientID = "{{ getenv "FRPC_AUTH_OIDC_CLIENT_ID" }}"
auth.oidc.clientSecret = "{{ getenv "FRPC_AUTH_OIDC_CLIENT_SECRET" }}"
auth.oidc.audience = "{{ getenv "FRPC_AUTH_OIDC_AUDIENCE" "frp" }}"
auth.oidc.tokenEndpointURL = "{{ getenv "FRPC_AUTH_OIDC_TOKEN_ENDPOINT_URL" }}"
{{- if getenv "FRPC_AUTH_OIDC_PROXY_URL" }}
auth.oidc.proxyURL = "{{ getenv "FRPC_AUTH_OIDC_PROXY_URL" }}"
{{- end }}
{{- end }}

log.level = "{{ getenv "FRPC_LOG_LEVEL" "info" }}"
loginFailExit = {{ getenv "LOGIN_FAIL_EXIT" "false" }}

[[proxies]]
name = "{{ getenv "FRPC_NAME" "frpc" }}"
type = "{{ getenv "FRPC_TYPE" "http" }}"
localIP = "{{ getenv "FRPC_LOCAL_IP" "127.0.0.1" }}"
localPort = {{ getenv "FRPC_LOCAL_PORT" "80" }}
customDomains = ["{{ getenv "FRPC_CUSTOM_DOMAIN" }}"]
{{- if getenv "FRPC_LOCATION" }}
locations = ["{{ getenv "FRPC_LOCATION" }}"]
{{- end }}
{{- if getenv "FRPC_HTTP_USER" }}
httpUser = "{{ getenv "FRPC_HTTP_USER" }}"
{{- end }}
{{- if getenv "FRPC_HTTP_PASSWORD" }}
httpPassword = "{{ getenv "FRPC_HTTP_PASSWORD" }}"
{{- end }}
{{- /* Clear FRP's HTTP Basic credentials before an upstream client adds its own rotating authorization. */}}
{{- if getenv "FRPC_CLEAR_AUTHORIZATION_HEADER" }}
requestHeaders.set.Authorization = ""
{{- else if getenv "FRPC_SET_AUTHORIZATION_BEARER_TOKEN" }}
requestHeaders.set.Authorization = "Bearer {{ getenv "TOKEN" }}"
{{- end }}
{{- /* The terminal route forwards to kube-token-proxy, which holds no credentials. It needs its own Basic Auth, because the route would otherwise put the Kubernetes API on the internet, so it is not rendered without one. */}}
{{- if and (getenv "FRPC_SHELL_LOCATION") (getenv "FRPC_SHELL_HTTP_USER") (getenv "FRPC_SHELL_HTTP_PASSWORD") }}

[[proxies]]
name = "{{ getenv "FRPC_NAME" "frpc" }}-shell"
type = "http"
localIP = "127.0.0.1"
localPort = {{ getenv "FRPC_SHELL_LOCAL_PORT" "8002" }}
customDomains = ["{{ getenv "FRPC_CUSTOM_DOMAIN" }}"]
locations = ["{{ getenv "FRPC_SHELL_LOCATION" }}"]
httpUser = "{{ getenv "FRPC_SHELL_HTTP_USER" }}"
httpPassword = "{{ getenv "FRPC_SHELL_HTTP_PASSWORD" }}"
requestHeaders.set.Authorization = ""
{{- end }}
